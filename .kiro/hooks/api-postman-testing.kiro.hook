{
  "enabled": true,
  "name": "API Insomnia Testing",
  "description": "Monitors API source code changes and suggests running Insomnia collection tests to validate functionality",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "src/**/*.java",
      "pom.xml",
      "src/main/resources/**/*.properties",
      "src/main/resources/**/*.yml",
      "src/main/resources/**/*.yaml"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "API source code or configuration has been modified. Please check if the API server is running and suggest testing the modified endpoints using Insomnia. If needed, provide the curl commands to test the endpoints manually."
  }
}