# ================================================================
# VESTA — Variables de entorno (plantilla)
# ================================================================
# Copia este archivo a .env y rellena con los valores reales.
# NUNCA subas el archivo .env a Git.
#
# Uso:
#   cp .env.example .env
#   nano .env
#   docker compose --env-file .env up -d --build
# ================================================================

# === PERFIL SPRING ===
# prod  → Oracle Cloud / producción
# dev   → desarrollo local con Docker Compose
SPRING_PROFILES_ACTIVE=prod

# === BASE DE DATOS ===
POSTGRES_USER=vesta_user
POSTGRES_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURA
POSTGRES_DB=vesta_db

# URL interna Docker — no cambiar si usas Docker Compose
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/vesta_db
SPRING_DATASOURCE_USERNAME=vesta_user
SPRING_DATASOURCE_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURA

# === JWT ===
# Generar con: openssl rand -base64 64
JWT_SECRET=CAMBIAR_POR_CLAVE_ALEATORIA_LARGA_64_CARACTERES_MINIMO
JWT_EXPIRATION=86400000

# === EMAIL (Gmail SMTP) ===
# App Password: https://myaccount.google.com/apppasswords
MAIL_USERNAME=tu-email@gmail.com
MAIL_PASSWORD=CAMBIAR_POR_APP_PASSWORD_GMAIL_16_CHARS

# === OAUTH2 GOOGLE ===
# Obtener en: https://console.cloud.google.com → APIs → Credenciales
GOOGLE_CLIENT_ID=CAMBIAR_POR_CLIENT_ID
GOOGLE_CLIENT_SECRET=CAMBIAR_POR_CLIENT_SECRET

# === URLs PÚBLICAS ===
# Sustituir <DOMINIO> por tu dominio real (ej: vesta-web.duckdns.org)
FRONTEND_URL=https://<DOMINIO>/vesta-web
API_URL=https://<DOMINIO>/vesta-api
CORS_ALLOWED_ORIGINS=https://<DOMINIO>

# === TWILIO SMS (opcional) ===
# Dejar vacío si no se usa SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
SMS_ENABLED=false
