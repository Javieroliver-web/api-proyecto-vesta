[Unit]
Description=Apache Tomcat Web Application Container
After=network.target

[Service]
Type=forking

User=tomcat
Group=tomcat

Environment="JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64"
Environment="CATALINA_PID=/opt/tomcat/temp/tomcat.pid"
Environment="CATALINA_HOME=/opt/tomcat"
Environment="CATALINA_BASE=/opt/tomcat"
Environment="CATALINA_OPTS=-Xms512M -Xmx1024M -server -XX:+UseG1GC"
Environment="JAVA_OPTS=-Djava.awt.headless=true -Djava.security.egd=file:/dev/./urandom"

# --- DATOS DEL PROYECTO ---
Environment="SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/vesta_db"
Environment="SPRING_DATASOURCE_USERNAME=vesta_user"
Environment="SPRING_DATASOURCE_PASSWORD=vesta_password"

# API URL
Environment="API_URL=http://34.175.116.7:8080/vesta-api/api"
Environment="SPRING_APPLICATION_JSON={\"api\":{\"url\":\"http://34.175.116.7:8080/vesta-api/api\"}}"

# URL Publica
Environment="FRONTEND_URL=http://vesta-web.duckdns.org/vesta-web"

# --- CORREO ---
Environment="MAIL_USERNAME=javip200555@gmail.com"
Environment="MAIL_PASSWORD=dzbgccdnrnwtrnnm"

# URLs para enlaces de activación
Environment="APP_BASE_URL=http://vesta-web.duckdns.org"
Environment="APP_FRONTEND_URL=http://vesta-web.duckdns.org/vesta-web"
# --------------------

ExecStart=/opt/tomcat/bin/startup.sh
ExecStop=/opt/tomcat/bin/shutdown.sh

[Install]
WantedBy=multi-user.target